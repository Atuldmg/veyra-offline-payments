# VEYRA — Environment Configuration Template
# NOTE: Do NOT place production secrets in this file. Copy to .env and configure.

# Database Configuration (MySQL / MariaDB / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=veyra_db
DB_USER=root
DB_PASS=

# Java Verification Microservice Connection
JAVA_VERIFIER_URL=http://127.0.0.1:8085
INTERNAL_API_KEY=veyra_internal_secret_token_change_in_production

# Application Environment (development | production)
APP_ENV=development
APP_DEBUG=true

# CORS Allowed Origin
CORS_ALLOWED_ORIGIN=*
