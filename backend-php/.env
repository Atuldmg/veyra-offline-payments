# VEYRA — Environment Configuration Example
# Copy this file to .env and adjust credentials as appropriate for your environment.

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_SECRET=veyra_app_session_secret_change_me_in_production

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=veyra_db
DB_USER=root
DB_PASS=

# Java Spring Boot Verification Microservice
JAVA_SERVICE_URL=http://127.0.0.1:8085
VEYRA_INTERNAL_API_KEY=veyra_secret_internal_token_2026
JAVA_SERVICE_TIMEOUT_SECONDS=5

# CORS (Allowed origins for browser frontend, comma separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://localhost:3000,https://veyra-offline.netlify.app
